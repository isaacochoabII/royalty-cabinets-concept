---
// Design-system hero: eyebrow (1–3 words), Outfit Light headline, lead, one primary action plus an optional arrow link.
// The right side holds one photograph (or its placeholder) via the default slot.
interface Props { eyebrow: string; title: string; lede: string }
const {eyebrow, title, lede} = Astro.props;
---
<section class="hero">
  <div class="wrap inner">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={title} />
      <p class="lead">{lede}</p>
      <slot name="actions" />
    </div>
    <div class="media"><slot /></div>
  </div>
</section>

<style>
  .hero { background: var(--surface); padding: var(--space-16) 0 var(--space-24); }
  .inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: var(--space-16); align-items: center; }
  .copy .eyebrow { margin-bottom: var(--space-6); }
  .copy .lead { margin-top: var(--space-6); }
  .hero :global(h1 .accent-text) { color: var(--text-accent); }
  .media:empty { display: none; }
  @media (max-width: 1023px) { .inner { grid-template-columns: 1fr; gap: var(--space-12); } .hero { padding: var(--space-12) 0 var(--space-16); } }
</style>
