---
// Design-system CTA band: one per page, eyebrow + one-sentence heading + one inverse button.
import {business} from '../data/site';
import {url} from '../data/url';
interface Props { eyebrow: string; title: string; text?: string; href: string; label: string }
const {eyebrow, title, text, href, label} = Astro.props;
---
<section class="band">
  <div class="wrap row">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {text && <p class="lead">{text}</p>}
    </div>
    <div class="side">
      <a class="btn btn-inverse" href={url(href)}>{label} <span class="arrow" aria-hidden="true">↗</span></a>
      <p class="contact"><a href={`tel:${business.tel}`}>{business.phone}</a> · <a href={`mailto:${business.email}`}>{business.email}</a></p>
    </div>
  </div>
</section>

<style>
  .band { background: var(--surface-inverse); color: var(--text-inverse); padding: var(--space-16) 0; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-8); align-items: center; justify-content: space-between; }
  .copy { display: grid; gap: var(--space-3); max-width: var(--measure); }
  .eyebrow, h2 { color: var(--text-inverse); }
  .lead { color: var(--inverse-muted); margin: var(--space-3) 0 0; }
  .side { display: grid; gap: var(--space-4); justify-items: start; }
  .contact { margin: 0; font-size: 14px; color: var(--inverse-muted); }
  .contact a { color: var(--text-inverse); text-decoration: none; border-bottom: var(--hairline) solid var(--accent); }
</style>
