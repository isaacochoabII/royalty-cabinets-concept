---
// Social profile links as thin line icons (design system: 1.5px single-weight, square caps, Lucide-style).
import {business} from '../data/site';
interface Props { class?: string }
const {class: className} = Astro.props;
---
<ul class:list={['social', className]}>
  {business.social.map((s) => (
    <li>
      <a href={s.url} rel="noopener" target="_blank" aria-label={`Royalty Cabinets on ${s.name}`} title={s.name}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
          {s.name === 'Instagram' && <><rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></>}
          {s.name === 'Facebook' && <path d="M18 2.75h-3a4.25 4.25 0 0 0-4.25 4.25v3H7.75v3.5h3V21.25h3.5V13.5h3l.75-3.5h-3.75V7a.75.75 0 0 1 .75-.75h3z" />}
          {s.name === 'LinkedIn' && <><path d="M16 8.5a5.5 5.5 0 0 1 5.25 5.5v7.25h-3.5V14a1.75 1.75 0 0 0-3.5 0v7.25h-3.5V14A5.5 5.5 0 0 1 16 8.5z" /><path d="M2.75 9.75h3.5v11.5h-3.5z" /><circle cx="4.5" cy="4.5" r="1.75" /></>}
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; margin: 0 0 0 -11px; padding: 0; display: flex; gap: var(--space-1); }
  .social a { display: inline-grid; place-items: center; width: var(--control-height); height: var(--control-height); color: inherit; opacity: .8; transition: opacity 200ms ease-out; }
  .social a:hover { opacity: 1; }
  .social svg { display: block; }
</style>
