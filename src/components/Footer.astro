---
import {business, nav} from '../data/site';
import {url} from '../data/url';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <img class="logo" src={url('brand/logo-cream.png')} width="640" height="139" alt="Royalty Cabinets" loading="lazy" />
        <p>Cabinet installation for builders, developers, cabinet manufacturers and homeowners. Based in Dieppe.</p>
      </div>
      <div>
        <h2 class="col-head">Contact</h2>
        <a href={`tel:${business.tel}`}>{business.phone}</a>
        <a href={`mailto:${business.email}`}>{business.email}</a>
        <p>{business.street}<br />{business.city}, {business.region} {business.postal}</p>
      </div>
      <div>
        <h2 class="col-head">Pages</h2>
        {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
        <a href={url('estimates/')}>Get a quote</a>
      </div>
      <div>
        <h2 class="col-head">Where we work</h2>
        {business.areas.map((a) => <p>{a}</p>)}
      </div>
    </div>
    <div class="base">
      <span>© {year} Royalty Cabinets</span>
      <a href={business.facebook} rel="noopener">Facebook</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-inverse); color: var(--text-inverse); padding: var(--space-12) 0 var(--space-8); }
  .cols { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: var(--space-8); }
  .logo { height: 28px; width: auto; margin-bottom: var(--space-4); }
  .col-head { margin: 0 0 var(--space-3); font: 500 12px/16px var(--font-body); letter-spacing: 0.28em; text-transform: uppercase; color: var(--text-inverse); }
  a, p { display: block; margin: 0 0 var(--space-2); font-size: 14px; line-height: 22px; letter-spacing: 0.02em; color: var(--text-inverse); text-decoration: none; max-width: 340px; }
  a:hover { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }
  .base { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-12); padding-top: var(--space-6); border-top: var(--hairline) solid var(--accent); font-size: 12px; line-height: 18px; letter-spacing: 0.04em; }
  .base a { display: inline; margin: 0; font-size: 12px; }
  @media (max-width: 719px) { .cols { grid-template-columns: 1fr 1fr; } .cols > div:first-child { grid-column: 1 / -1; } }
</style>
